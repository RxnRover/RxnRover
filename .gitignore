########## LabVIEW Ignores ##########

# Libraries
*.lvlibp
*.llb

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
# do not ignore executable for this branch *.exe
builds/

# Metadata
*.aliases
*.lvlps
.cache/

########## Python Ignores ##########

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Sphinx documentation
**/_build/
**/build/


# Environments
.env
.venv
env/
venv*/
ENV/
env.bak/
venv.bak/

########## Project Ignores ##########

docs/source/_static/api
logs/
# plugins/ (do not ignore plugins for the executable)

# todo.txt ignores
**/todo.txt
**/done.txt
**/waiting.txt
**/someday.txt
